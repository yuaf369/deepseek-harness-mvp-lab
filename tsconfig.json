{
    "compilerOptions": {
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "Bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "outDir": "dist",
        "rootDir": ".",
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "examples/**/*.ts"
    ]
}